FROM mcr.microsoft.com/playwright:v1.60.0-jammy

WORKDIR /app

ENV CI=1 \
    NODE_ENV=test \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    CHROME_PATH=/ms-playwright/chromium-1223/chrome-linux64/chrome

COPY package.json ./
RUN npm install --no-audit

COPY . .

CMD ["npm", "test"]
