---
import Base from '../layouts/Base.astro';
---
<Base title="Sito Psi — Home">
  <main>
    <section class="hero">
      <h1>Sito Psi</h1>
      <p>Scaffolding Astro pronto. Modifica <code>src/pages/index.astro</code> e vedi le modifiche in tempo reale.</p>
    </section>
  </main>
</Base>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0 0 1rem;
  }

  .hero p {
    font-size: 1.125rem;
    opacity: 0.85;
  }

  code {
    background: rgba(0, 0, 0, 0.06);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.95em;
  }
</style>
